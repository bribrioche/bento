{
  "name": "bento-suite-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Bento launcher and its locally buildable app collection",
  "scripts": {
    "setup": "npm ci --prefix bento",
    "dev": "npm run dev --prefix bento",
