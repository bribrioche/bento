{
  "name": "hub-launcher",
  "version": "2.0.0",
  "description": "A curated desktop app collection and launcher",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "build:icon": "node scripts/build-icon.cjs",
    "prepare:installers": "node scripts/prepare-installers.cjs",
    "dist": "npm run prepare:installers && npm run build && electron-builder",
    "check": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.hub.launcher",
    "productName": "Bento",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "asarUnpack": ["electron/focus-existing.ps1"],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "vendor/installers/lumen/setup.exe", "to": "installers/lumen/setup.exe" },
      { "from": "vendor/installers/pasta/setup.exe", "to": "installers/pasta/setup.exe" },
      { "from": "vendor/installers/agent-launcher/setup.exe", "to": "installers/agent-launcher/setup.exe" },
      { "from": "vendor/installers/pullscope/setup.exe", "to": "installers/pullscope/setup.exe" }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Bento Setup ${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "sharp": "^0.33.5",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
